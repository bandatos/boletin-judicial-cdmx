include head.pug
include chrome.pug
include mixins.pug

- const titulo = q ? `Empresas: “${q}”` : 'Juicios de empresas en la Ciudad de México'
- const baseParams = Object.assign(q ? { q } : {}, orden === 'nombre' ? { orden } : {})
+head(q ? `${titulo} — ${siteTitle}` : `Empresas con juicios en la Ciudad de México — ${siteTitle}`, 'Qué empresas tienen juicios civiles, mercantiles y familiares en la Ciudad de México, como actora o demandada, según el Boletín Judicial del PJCDMX desde 2016.')
  +siteHeader('empresas')

  +breadcrumbs([[siteTitle, '/'], ['Empresas']])

  .container.empresas-view
    h1.titulo-seccion Empresas
    p.nota.
      Empresas que aparecen como actora o demandada en el Boletín Judicial del
      Poder Judicial de la Ciudad de México desde octubre de 2016: tipos de
      juicio, juzgados, expedientes y la liga a cada publicación oficial.

    form.buscador-simple(method="GET" action="/empresas")
      input(type="search" name="q" value=q placeholder="Busca una empresa por nombre..." autocomplete="off" aria-label="Nombre de la empresa")
      if orden === 'nombre'
        input(type="hidden" name="orden" value="nombre")
      button(type="submit") Buscar

    .bloque#empresas
      p.orden
        | #{num(lista.total)} empresas · ordenar por
        = ' '
        if orden === 'nombre'
          a(href=`/empresas?${new URLSearchParams(q ? { q } : {})}`) cantidad de avisos
          |  ·
          strong  nombre
        else
          strong cantidad de avisos
          |  ·
          = ' '
          a(href=`/empresas?${new URLSearchParams(Object.assign(q ? { q } : {}, { orden: 'nombre' }))}`) nombre

      table.empresas-tabla
        thead
          tr
            th Empresa
            th.num Avisos
            th.num Como actora
            th.num Como demandada
            th.num Expedientes
            th Período
        tbody
          each e in lista.rows
            tr
              td
                a(href=`/empresas/${e.slug}`)= e.nombre
              td.num= num(e.avisos)
              td.num= num(e.como_actora)
              td.num= num(e.como_demandada)
              td.num= num(e.expedientes || 0)
              td.periodo= `${fechaCorta(e.primer_boletin)} a ${fechaCorta(e.ultimo_boletin)}`
      if !lista.rows.length
        p Sin empresas que coincidan.

      +paginacion(lista.pagina, lista.paginas, p => `/empresas?${new URLSearchParams(Object.assign({}, baseParams, { p }))}`)

    p.nota.
      La empresa se reconoce por el nombre publicado en el boletín (no incluye
      RFC), así que variantes muy distintas de un mismo nombre pueden figurar por
      separado. Solo se listan empresas: las personas físicas no se nombran.

  +siteFooter()
