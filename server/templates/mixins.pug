//- Enlace a Todo Derecho Vecino, igual en todo el sitio. Es un asistente
//- para problemas vecinales (ruido, antros, construcciones, uso de suelo),
//- no para cualquier juicio: el texto y el título lo dicen.
mixin enlaceTDV(texto)
  a(href=TDV_URL target="_blank" rel="noopener"
    title="Todo Derecho Vecino, de Bandatos: describes tu problema vecinal (ruido, antros, construcciones, uso de suelo) y te propone una ruta para resolverlo. Gratis; la respuesta tarda de 30 a 60 segundos (otro sitio)")= texto || 'Orientación vecinal gratuita ↗'

//- Etiqueta "vs" entre las partes, para distinguir dónde termina una y
//- empieza la otra en nombres largos. El texto sigue siendo " vs. " para
//- lectores de pantalla y para copiar.
mixin vs()
  = ' '
  span.vs(aria-label="contra") vs.
  = ' '

//- Qué pasó en un aviso, igual en todas las páginas: la etiqueta (con su
//- color, ver actuacionClase), lo que escribió el juzgado si lo escribió, y
//- el cuaderno o tomo si no es el principal. Bases viejas: solo el conteo.
mixin etiquetaAviso(a)
  if etiqueta(a)
    span.actuacion(class=actuacionClase(a))= etiqueta(a)
  if a.descripcion && a.descripcion !== etiqueta(a)
    = ' '
    span.lt-desc= expandirAbreviaturas(a.descripcion)
  if acuerdosExtra(a)
    span.lt-extra= acuerdosExtra(a)
  if a.cuaderno
    span.lt-tipo= a.cuaderno

//- Marca de que el expediente ya tiene sentencia definitiva, para listas.
//- La fecha va dentro de la etiqueta: es la del boletín que publicó el
//- aviso de sentencia.
mixin marcaSentencia(fechaIso)
  span.marca-sentencia
    span.actuacion.act-sentencia(title=fechaIso ? `Sentencia publicada en el boletín del ${fechaMedia(fechaIso)}` : null)
      | Sentencia
      if fechaIso
        |  #{fechaCorta(fechaIso).replace('.', '')}

//- Línea de tiempo de avisos: un punto por aviso, del más reciente al más
//- viejo. La usan la ficha y el despliegue de avisos de las listas
//- (/expediente/:id/avisos). tipoFicha: el tipo de juicio del expediente,
//- para mostrar el de cada aviso solo si es otro.
mixin lineaTiempo(avisos, tipoFicha)
  ol.linea-tiempo
    each a in avisos
      li(class=`lt-${actuacionClase(a).replace('act-', '')}`)
        .lt-fecha
          if a.fecha_iso
            a(href=`/fecha/${a.fecha_iso}` title=`Todo lo que publicó el Boletín Judicial el ${fechaMedia(a.fecha_iso)}`)
              time(datetime=a.fecha_iso)= fechaCorta(a.fecha_iso)
          else
            = a.fecha || '—'
        .lt-que
          +etiquetaAviso(a)
          if (a.tipo_juicio_norm || a.tipo_juicio) && (a.tipo_juicio_norm || a.tipo_juicio) !== tipoFicha
            span.lt-tipo= a.tipo_juicio
        .lt-links
          if a.sentencia_publica
            +sentenciaLink(a, 'Ver sentencia')
          if a.pdf_url
            +pdfLink(a, a.pagina ? `Boletín p. ${a.pagina}` : 'Boletín')

//- Un expediente en una lista (búsqueda, juzgado, empresa, persona). Mismo
//- componente en todas: primero el número y el órgano (lo que identifica al
//- expediente), después las partes (el bloque, que cambia según la página),
//- el tipo de juicio con el último aviso, y los avisos, que se cargan al
//- desplegar con la misma línea de tiempo de la ficha.
//- Orden fijo en todo el sitio: expediente, tipo de juicio, juzgado,
//- secretaría.
//- x: { id, href, expediente, tipo, organo, secretaria, avisos, ultimo,
//-      sentencia, encontrados }. encontrados: en la búsqueda, los avisos
//- contados son los que coinciden con lo buscado, no todos los del
//- expediente. La misma tarjeta en búsqueda, juzgado, persona y empresa.
mixin expedienteItem(x)
  article.exp-item
    header
      a.exp-item-num(href=x.href title=tituloFicha(x.expediente) data-accion="abrir_expediente") Exp. #{x.expediente || '—'}
      if x.tipo
        span.exp-item-tipo= x.tipo
      span.exp-item-organo
        = x.organo || '—'
        if secretariaCorta(x.secretaria)
          |  · #{secretariaCorta(x.secretaria)}
      if x.sentencia
        +marcaSentencia(x.sentencia)
    if block
      .exp-item-partes
        block
    //- Cuántos avisos y hasta cuándo, y la ficha para el detalle. La línea
    //- de tiempo y los boletines están en la ficha. En la búsqueda los
    //- avisos son los que coinciden con lo buscado ("encontrados").
    - const hasta = x.ultimo && x.ultimo.fecha_iso ? fechaMedia(x.ultimo.fecha_iso) : '—'
    - const enc = x.encontrados ? (x.avisos === 1 ? ' encontrado' : ' encontrados') : ''
    p.exp-item-meta
      if x.avisos === 1
        | 1 aviso#{enc}, del #{hasta}
      else
        | #{num(x.avisos)} avisos#{enc} hasta el #{hasta}
      |  · 
      a(href=x.href title=tituloFicha(x.expediente) data-accion="ver_detalles") Ver detalles

mixin resultCard(g, buscado)
  - const avisosOrden = g.avisos.slice().sort((x, y) => String(y.fecha_iso || '').localeCompare(String(x.fecha_iso || '')) || y.id - x.id)
  - const sentCard = avisosOrden.find(esSentenciaFinal)
  +expedienteItem({ id: g.id, href: expedienteHref(g), expediente: g.expediente, tipo: g.tipo_juicio_norm || g.tipo_juicio, organo: g.sala || g.juzgado, secretaria: g.secretaria, avisos: g.avisos.length, encontrados: true, ultimo: avisosOrden[0] || g, sentencia: sentCard && sentCard.fecha_iso })
    if g.demandada
      b!= resaltar(g.actora, buscado)
      +vs()
      b!= resaltar(g.demandada, buscado)
    else
      b!= resaltar(g.actora, buscado)

//- Link al PDF del boletín en la página del aviso. behavior.js lo abre en el
//- panel lateral; con Ctrl o clic del medio sigue siendo un link común.
mixin pdfLink(r, texto)
  a.ver-pdf(href=pdfHref(r) target="_blank" rel="noopener"
    title=`Abre el Boletín Judicial${r.fecha_iso ? ` del ${fechaMedia(r.fecha_iso)}` : ''}${r.pagina ? `, página ${r.pagina}` : ''} (PDF oficial del Poder Judicial)`
    data-pdf=r.pdf_url data-pagina=r.pagina || ''
    data-titulo=['Boletín', r.fecha_iso && fechaCorta(r.fecha_iso), r.pagina && `p. ${r.pagina}`].filter(Boolean).join(' · '))= texto

//- Versión pública de la sentencia (SIVEP), en el mismo panel que el
//- boletín. /sentencia-publica/:id redirige a la URL vigente del PDF.
mixin sentenciaLink(a, texto, clase)
  a.ver-pdf(class=clase href=`/sentencia-publica/${a.id}` target="_blank" rel="noopener nofollow"
    title="Abre la versión pública de la sentencia: una copia sin nombres que publica el Poder Judicial (PDF)"
    data-pdf=`/sentencia-publica/${a.id}` data-pagina="" data-tipo="sentencia"
    data-titulo=['Sentencia (versión pública)', a.fecha_iso && fechaCorta(a.fecha_iso)].filter(Boolean).join(' · '))= texto

//- Avisos de un día (vista /fecha), en el orden del PDF.
mixin avisosDia(rows)
  ol.avisos-dia
    - let secretaria = null
    each r in rows
      if r.secretaria && r.secretaria !== secretaria
        - secretaria = r.secretaria
        li.secretaria= r.secretaria
      li
        div
          b= r.actora
          if r.demandada
            +vs()
            | #{r.demandada}
        .aviso-meta
          = [r.tipo_juicio, r.expediente && `Exp. ${r.expediente}`].filter(Boolean).join(' · ')
          = ' · '
          +etiquetaAviso(r)
          if r.pdf_url
            |  ·
            = ' '
            +pdfLink(r, r.pagina ? `ver boletín (p. ${r.pagina})` : 'ver boletín')

//- Paginador con el formato del de sociedad-web-front (templates/buscador.pug):
//- flechas, primera y última página, una ventana de 4 páginas alrededor de
//- la actual y "..." cuando se saltean páginas.
//- total null: no se sabe cuántas páginas hay (búsquedas muy grandes); se
//- muestra hasta la actual y, si hayMas, la siguiente, sin "última".
mixin paginacion(actual, total, href, hayMas)
  - const conocido = total != null
  - total = conocido ? total : actual + (hayMas ? 1 : 0)
  if total > 1
    - const VENTANA = 4
    - let desde = Math.max(1, actual - 1)
    - let hasta = Math.min(total, desde + VENTANA - 1)
    - desde = Math.max(1, hasta - VENTANA + 1)
    nav.pagesContainer.pagesContainer-center(role="navigation" aria-label="Paginación")
      if actual > 1
        a.page.arrow(href=href(actual - 1) aria-label="Página anterior" rel="prev")
          span(aria-hidden="true") ←
      if desde > 1
        a.page(href=href(1) aria-label="Primera página") 1
        if desde > 2
          span.page-ellipsis(aria-hidden="true") …
      - for (let n = desde; n <= hasta; n++)
        if n === actual
          a.page.current(href=href(n) aria-current="page" aria-label=`Página actual, ${num(n)}`)= num(n)
        else
          a.page(href=href(n) aria-label=`Ir a la página ${num(n)}`)= num(n)
      if conocido && hasta < total
        if hasta < total - 1
          span.page-ellipsis(aria-hidden="true") …
        a.page(href=href(total) aria-label=`Última página, ${num(total)}`)= num(total)
      if actual < total
        a.page.arrow(href=href(actual + 1) aria-label="Página siguiente" rel="next")
          span(aria-hidden="true") →

//- Avisos por período (año o mes), apilados por bucket (colores en
//- chart.colors). chart: db.getYearChart(), db.getPublicacionChart() o
//- db.serie(). Por mes la etiqueta va solo en enero y el resumen accesible
//- se da por año (120 meses en un aria-label no se pueden escuchar).
mixin graficoAnios(chart, titulo)
  .chart-box
    if titulo
      h2.chart-title= titulo
    - const porAnioResumen = new Map()
    - for (const y of chart.years) { const a = String(y.anio).slice(0, 4); porAnioResumen.set(a, (porAnioResumen.get(a) || 0) + y.total) }
    - const resumenChart = [...porAnioResumen].map(([a, n]) => `${a}: ${num(n)}`).join('; ')
    .chart(class=chart.porMes ? 'chart-mensual' : null role="img" aria-label=`${titulo || (chart.porMes ? 'Avisos por mes' : 'Avisos por año')}. Total por año: ${resumenChart}.`)
      each y in chart.years
        .chart-col(style=`height:${(y.total / chart.maxTotal) * 100}%` data-valor=`${y.titulo || y.anio}: ${num(y.total)} avisos` aria-hidden="true")
          each seg, i in y.segments
            if seg.n
              .chart-col-segment(style=`height:${(seg.n / y.total) * 100}%;background:${chart.colors[i]}`)
    .chart-labels(class=chart.porMes ? 'chart-mensual' : null aria-hidden="true")
      each y in chart.years
        .chart-col-label= y.etiqueta != null ? y.etiqueta : y.anio
    if chart.buckets.length > 1
      .chart-legend(aria-hidden="true")
        each b, i in chart.buckets
          span.chart-legend-item
            span.chart-legend-swatch(style=`background:${chart.colors[i]}`)
            = b
    if chart.huecos && chart.huecos.length
      p.nota Sin boletines publicados en #{chart.huecos.join(', ')}.

//- El mismo gráfico por año y por mes, con un selector. Sin serie mensual
//- (base sin estadísticas), solo el anual.
mixin graficoAnioMes(anual, mensual, id, titulo)
  if mensual
    +pestanas(id, [{ id: `${id}-anio`, titulo: 'Por año' }, { id: `${id}-mes`, titulo: 'Por mes' }], 'pestanas-periodo')
    div(id=`${id}-anio` role="tabpanel" aria-labelledby=`tab-${id}-anio`)
      +graficoAnios(anual, titulo)
    div(id=`${id}-mes` role="tabpanel" aria-labelledby=`tab-${id}-mes` hidden)
      +graficoAnios(mensual, titulo)
  else
    +graficoAnios(anual, titulo)

//- Tiempo hasta sentencia por año: mediana y rango intercuartil.
mixin tablaDuracion(filas)
  table.empresas-tabla
    thead
      tr
        th Año de la sentencia
        th.num Expedientes
        th.num Mediana
        th.num La mitad entre
    tbody
      each d in filas.slice().reverse()
        tr
          td= d.anio
          td.num= num(d.n)
          td.num= dias(d.mediana)
          td.num= `${dias(d.p25)} y ${dias(d.p75)}`

//- Tarjeta: título con ícono, contenido (block) y link a la sección.
mixin tarjeta(icono, titulo, verTodos, verTodosTexto)
  section.tarjeta
    h2.tarjeta-titulo
      span.tarjeta-icono(aria-hidden="true")= icono
      = titulo
    block
    if verTodos
      p.tarjeta-pie
        a.boton-borde(href=verTodos)= verTodosTexto

//- Pestañas: [{ id, titulo }]. Cada una muestra el tabpanel con ese id
//- (behavior.js). Sin JS se ve la primera.
mixin pestanas(grupo, pestanas, clase)
  .pestanas(role="tablist" class=clase)
    each p, i in pestanas
      button.pestana(type="button" role="tab" id=`tab-${p.id}` aria-controls=p.id aria-selected=(i === 0 ? 'true' : 'false') data-grupo=grupo)= p.titulo

//- Expediente de una empresa: la otra parte solo como empresas o "persona(s)
//- física(s)" (estas páginas se indexan y no nombran personas).
mixin expedienteEmpresa(x)
  +expedienteItem({ id: x.ultimo_id, href: expedienteHref({ id: x.ultimo_id, expediente: x.expediente }), expediente: x.expediente, tipo: x.tipo_juicio, organo: x.organo, secretaria: x.secretaria, avisos: x.avisos, ultimo: x, sentencia: x.sentencia && x.sentencia.fecha_iso })
    b= x.rol === 'actora' ? 'Actora' : 'Demandada'
    = x.rol === 'actora' ? ', contra ' : ', demandada por '
    if x.contraEmpresas.length
      each c, i in x.contraEmpresas
        if i
          | ,
          = ' '
        a(href=`/empresas/${c.slug}` title=`Todos los juicios de ${c.nombre} en el boletín`)= c.nombre
      if x.contraPersonas
        |  y persona(s) física(s)
    else if x.contraPersonas
      | persona(s) física(s)
    else
      | (sin contraparte en el aviso)

//- Pregunta de intención, una vez por navegador: se muestra por CSS según
//- la clase que pone head.pug antes de pintar, y behavior.js maneja las
//- respuestas. Después de responder, la misma franja muestra el formulario
//- de opinión (formOpinion), con la respuesta adjunta. Si no lo envía ni lo
//- rechaza, se le ofrece una sola vez más, a los 3 días o más (#reoferta).
//- lugar: 'busqueda' (por defecto), 'empresa' o 'expediente'. Mismo valor en
//- GA para respuestas equivalentes, y tipo_pagina dice desde dónde.
mixin preguntaIntencion(lugar)
  - const enEmpresa = lugar === 'empresa'
  - const opciones = enEmpresa ? [['propio', 'Tengo un juicio con esta empresa'], ['empresa', 'Quiero saber cómo es antes de contratar, comprar o rentar'], ['trabajo', 'Trabajo (casos de clientes, periodismo, investigación)'], ['otro', 'Otra cosa']] : [['propio', 'Mi propio juicio'], ['conocido', 'El de alguien que conozco'], ['empresa', 'Una empresa o un inmueble'], ['trabajo', 'Trabajo (casos de clientes, periodismo, investigación)'], ['otro', 'Otra cosa']]
  - const titulo = enEmpresa ? '¿Por qué consultas esta empresa?' : lugar === 'expediente' ? '¿Para qué consultas este expediente?' : '¿Para qué estás buscando?'
  section#intencion.intencion(aria-labelledby="intencion-titulo")
    button.intencion-cerrar(type="button" aria-label="Cerrar") ✕
    p.intencion-etiqueta Pregunta del equipo de Bandatos
    .intencion-pregunta
      h2#intencion-titulo= titulo
      p.nota Nos ayuda a mejorar el sitio. Es anónimo y solo te lo preguntamos una vez.
      .intencion-opciones
        each o in opciones
          button(type="button" data-valor=o[0])= o[1]
    .intencion-gracias(hidden)
      h2 ¡Gracias! ¿Nos cuentas más sobre tu experiencia?
      p.nota Nos ayuda a seguir mejorando la plataforma. Es anónimo y puedes llenar uno solo de los campos.
      +formOpinion('pregunta', { conNo: true })
  section#reoferta.intencion.reoferta(aria-labelledby="reoferta-titulo")
    button.intencion-cerrar(type="button" aria-label="Cerrar") ✕
    p.intencion-etiqueta Pregunta del equipo de Bandatos
    h2#reoferta-titulo ¿Nos cuentas tu experiencia?
    p.nota Hace unos días nos contaste para qué usas el sitio. Si nos das más detalles, podemos seguir mejorándolo. Es anónimo.
    +formOpinion('reoferta', { conNo: true })
