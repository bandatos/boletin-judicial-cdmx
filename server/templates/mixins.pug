mixin resultCard(g, buscado)
  .card
    .card-partes
      if g.demandada
        b!= resaltar(g.actora, buscado)
        span.card-vs &nbsp;vs.&nbsp;
        b!= resaltar(g.demandada, buscado)
      else
        b!= resaltar(g.actora, buscado)
    .card-meta
      if g.tipo_juicio
        span.tag= g.tipo_juicio
      span Exp. #{g.expediente || '—'}
      span= g.juzgado || '—'
      if g.sala
        span= g.sala
      if g.fecha_iso
        a(href=`/fecha/${g.fecha_iso}`)= fechaCorta(g.fecha_iso)
      else
        span= g.fecha || '—'
    if g.avisos.length > 1
      details.card-avisos
        summary= num(g.avisos.length) + ' avisos'
        ul
          each a in g.avisos.slice().sort((x, y) => (y.boletin_id || 0) - (x.boletin_id || 0))
            li
              if a.fecha_iso
                a(href=`/fecha/${a.fecha_iso}`)= fechaCorta(a.fecha_iso)
              else
                = a.fecha || '—'
              if a.tipo_juicio
                |  — #{a.tipo_juicio}
              if a.pdf_url
                |  —
                = ' '
                +pdfLink(a, 'PDF')
    .card-links
      a.card-detail-link(href=expedienteHref(g)) Ver expediente completo
      if g.pdf_url
        +pdfLink(g, 'Ver PDF del boletín')

//- Link al PDF del boletín en la página del aviso. behavior.js lo abre en el
//- panel lateral; con Ctrl o clic del medio sigue siendo un link común.
mixin pdfLink(r, texto)
  a.ver-pdf(href=pdfHref(r) target="_blank" rel="noopener"
    data-pdf=r.pdf_url data-pagina=r.pagina || ''
    data-titulo=[r.fecha_iso && fechaCorta(r.fecha_iso), r.pagina && `p. ${r.pagina}`].filter(Boolean).join(' · '))= texto

//- Avisos de un día (vista /fecha), en el orden del PDF.
mixin avisosDia(rows)
  ol.avisos-dia
    - let secretaria = null
    each r in rows
      if r.secretaria && r.secretaria !== secretaria
        - secretaria = r.secretaria
        li.secretaria= r.secretaria
      li
        div
          b= r.actora
          if r.demandada
            |  vs. #{r.demandada}
        .aviso-meta
          = [r.tipo_juicio, r.expediente && `Exp. ${r.expediente}`, r.num_acdos && `${r.num_acdos} acdo${r.num_acdos > 1 ? 's' : ''}.`].filter(Boolean).join(' · ')
          if r.pdf_url
            |  ·
            = ' '
            +pdfLink(r, r.pagina ? `ver en PDF (p. ${r.pagina})` : 'ver PDF')

//- Paginador con el formato del de sociedad-web-front (templates/buscador.pug):
//- flechas, primera y última página, una ventana de 4 páginas alrededor de
//- la actual y "..." cuando se saltean páginas.
//- total null: no se sabe cuántas páginas hay (búsquedas muy grandes); se
//- muestra hasta la actual y, si hayMas, la siguiente, sin "última".
mixin paginacion(actual, total, href, hayMas)
  - const conocido = total != null
  - total = conocido ? total : actual + (hayMas ? 1 : 0)
  if total > 1
    - const VENTANA = 4
    - let desde = Math.max(1, actual - 1)
    - let hasta = Math.min(total, desde + VENTANA - 1)
    - desde = Math.max(1, hasta - VENTANA + 1)
    nav.pagesContainer.pagesContainer-center(role="navigation" aria-label="Paginación")
      if actual > 1
        a.page.arrow(href=href(actual - 1) aria-label="Página anterior" rel="prev")
          span(aria-hidden="true") ←
      if desde > 1
        a.page(href=href(1) aria-label="Primera página") 1
        if desde > 2
          span.page-ellipsis(aria-hidden="true") …
      - for (let n = desde; n <= hasta; n++)
        if n === actual
          a.page.current(href=href(n) aria-current="page" aria-label=`Página actual, ${num(n)}`)= num(n)
        else
          a.page(href=href(n) aria-label=`Ir a la página ${num(n)}`)= num(n)
      if conocido && hasta < total
        if hasta < total - 1
          span.page-ellipsis(aria-hidden="true") …
        a.page(href=href(total) aria-label=`Última página, ${num(total)}`)= num(total)
      if actual < total
        a.page.arrow(href=href(actual + 1) aria-label="Página siguiente" rel="next")
          span(aria-hidden="true") →

//- Avisos por período (año o mes), apilados por bucket (colores en
//- chart.colors). chart: db.getYearChart(), db.getPublicacionChart() o
//- db.serie(). Por mes la etiqueta va solo en enero y el resumen accesible
//- se da por año (120 meses en un aria-label no se pueden escuchar).
mixin graficoAnios(chart, titulo)
  .chart-box
    if titulo
      h2.chart-title= titulo
    - const porAnioResumen = new Map()
    - for (const y of chart.years) { const a = String(y.anio).slice(0, 4); porAnioResumen.set(a, (porAnioResumen.get(a) || 0) + y.total) }
    - const resumenChart = [...porAnioResumen].map(([a, n]) => `${a}: ${num(n)}`).join('; ')
    .chart(class=chart.porMes ? 'chart-mensual' : null role="img" aria-label=`${titulo || (chart.porMes ? 'Avisos por mes' : 'Avisos por año')}. Total por año: ${resumenChart}.`)
      each y in chart.years
        .chart-col(style=`height:${(y.total / chart.maxTotal) * 100}%` data-valor=`${y.titulo || y.anio}: ${num(y.total)} avisos` aria-hidden="true")
          each seg, i in y.segments
            if seg.n
              .chart-col-segment(style=`height:${(seg.n / y.total) * 100}%;background:${chart.colors[i]}`)
    .chart-labels(class=chart.porMes ? 'chart-mensual' : null aria-hidden="true")
      each y in chart.years
        .chart-col-label= y.etiqueta != null ? y.etiqueta : y.anio
    if chart.buckets.length > 1
      .chart-legend(aria-hidden="true")
        each b, i in chart.buckets
          span.chart-legend-item
            span.chart-legend-swatch(style=`background:${chart.colors[i]}`)
            = b
    if chart.huecos && chart.huecos.length
      p.nota Sin boletines publicados en #{chart.huecos.join(', ')}.

//- El mismo gráfico por año y por mes, con un selector. Sin serie mensual
//- (base sin estadísticas), solo el anual.
mixin graficoAnioMes(anual, mensual, id, titulo)
  if mensual
    +pestanas(id, [{ id: `${id}-anio`, titulo: 'Por año' }, { id: `${id}-mes`, titulo: 'Por mes' }], 'pestanas-periodo')
    div(id=`${id}-anio` role="tabpanel" aria-labelledby=`tab-${id}-anio`)
      +graficoAnios(anual, titulo)
    div(id=`${id}-mes` role="tabpanel" aria-labelledby=`tab-${id}-mes` hidden)
      +graficoAnios(mensual, titulo)
  else
    +graficoAnios(anual, titulo)

//- Tiempo hasta sentencia por año: mediana y rango intercuartil.
mixin tablaDuracion(filas)
  table.empresas-tabla
    thead
      tr
        th Año de la sentencia
        th.num Expedientes
        th.num Mediana
        th.num La mitad entre
    tbody
      each d in filas.slice().reverse()
        tr
          td= d.anio
          td.num= num(d.n)
          td.num= dias(d.mediana)
          td.num= `${dias(d.p25)} y ${dias(d.p75)}`

//- Tarjeta: título con ícono, contenido (block) y link a la sección.
mixin tarjeta(icono, titulo, verTodos, verTodosTexto)
  section.tarjeta
    h2.tarjeta-titulo
      span.tarjeta-icono(aria-hidden="true")= icono
      = titulo
    block
    if verTodos
      p.tarjeta-pie
        a.boton-borde(href=verTodos)= verTodosTexto

//- Pestañas: [{ id, titulo }]. Cada una muestra el tabpanel con ese id
//- (behavior.js). Sin JS se ve la primera.
mixin pestanas(grupo, pestanas, clase)
  .pestanas(role="tablist" class=clase)
    each p, i in pestanas
      button.pestana(type="button" role="tab" id=`tab-${p.id}` aria-controls=p.id aria-selected=(i === 0 ? 'true' : 'false') data-grupo=grupo)= p.titulo

//- Expediente de una empresa: la otra parte solo como empresas o "persona(s)
//- física(s)" (estas páginas se indexan y no nombran personas).
mixin expedienteEmpresa(x)
  li
    div
      b= x.rol === 'actora' ? 'Actora' : 'Demandada'
      |  en #{x.organo || 'órgano no identificado'} · Exp. #{x.expediente || '—'}
    .aviso-meta
      | #{x.rol === 'actora' ? 'contra' : 'demandada por'}
      = ' '
      if x.contraEmpresas.length
        each c, i in x.contraEmpresas
          if i
            | ,
            = ' '
          a(href=`/empresas/${c.slug}`)= c.nombre
        if x.contraPersonas
          |  y persona(s) física(s)
      else if x.contraPersonas
        | persona(s) física(s)
      else
        | (sin contraparte en el aviso)
    .aviso-meta
      = [x.tipo_juicio, `${num(x.avisos)} aviso${x.avisos > 1 ? 's' : ''}`].filter(Boolean).join(' · ')
      |  · último:
      = ' '
      if x.fecha_iso
        a(href=`/fecha/${x.fecha_iso}`)= fechaCorta(x.fecha_iso)
      if x.pdf_url
        |  ·
        = ' '
        +pdfLink(x, x.pagina ? `PDF (p. ${x.pagina})` : 'PDF')

//- Pregunta de intención, una vez por navegador: se muestra por CSS según
//- la clase que pone head.pug antes de pintar, y behavior.js maneja las
//- respuestas. Después de responder, invitación a una entrevista con el
//- texto según la respuesta (data-invita). La respuesta queda marcada en el
//- formulario (OPCIONES_FORM en behavior.js). Si no contesta la invitación, se
//- le ofrece una sola vez más, a los 3 días o más (#reoferta).
//- lugar: 'busqueda' (por defecto), 'empresa' o 'expediente'. Mismo valor en
//- GA para respuestas equivalentes, y tipo_pagina dice desde dónde.
mixin preguntaIntencion(lugar)
  - const enEmpresa = lugar === 'empresa'
  - const invita = { propio: '¿Nos cuentas cómo sigues tu juicio? Queremos que el sitio le sirva más a gente en tu situación.', conocido: '¿Nos cuentas cómo acompañas ese juicio? Queremos que el sitio le sirva más a gente en tu situación.', empresa: '¿Nos cuentas qué querías saber? Queremos que el sitio sirva mejor para averiguar sobre empresas.', trabajo: '¿Nos cuentas cómo lo usas en tu trabajo? Queremos saber qué te falta.', otro: '¿Nos cuentas para qué lo usas? Queremos entender qué necesitas.' }
  - const opciones = enEmpresa ? [['propio', 'Tengo un juicio con esta empresa'], ['empresa', 'Quiero saber cómo es antes de contratar, comprar o rentar'], ['trabajo', 'Trabajo (abogacía, periodismo, investigación)'], ['otro', 'Otra cosa']] : [['propio', 'Mi propio juicio'], ['conocido', 'El de alguien que conozco'], ['empresa', 'Una empresa o un inmueble'], ['trabajo', 'Trabajo (abogacía, periodismo, investigación)'], ['otro', 'Otra cosa']]
  - const titulo = enEmpresa ? '¿Por qué consultas esta empresa?' : lugar === 'expediente' ? '¿Para qué consultas este expediente?' : '¿Para qué estás buscando?'
  section#intencion.intencion(aria-labelledby="intencion-titulo")
    button.intencion-cerrar(type="button" aria-label="Cerrar la pregunta") ✕
    .intencion-pregunta
      h2#intencion-titulo= titulo
      p.nota Nos ayuda a mejorar el sitio. Es anónimo y solo te lo preguntamos una vez.
      .intencion-opciones
        each o in opciones
          button(type="button" data-valor=o[0] data-invita=invita[o[0]])= o[1]
    .intencion-gracias(hidden)
      h2 ¡Gracias!
      +invitacionEntrevista('pregunta', invita.otro)
  section#reoferta.intencion.reoferta(aria-labelledby="reoferta-titulo")
    button.intencion-cerrar(type="button" aria-label="Cerrar la invitación") ✕
    h2#reoferta-titulo ¿Platicamos 20 minutos?
    +invitacionEntrevista('reoferta', 'Hace unos días nos contaste para qué usas el sitio. Queremos entender mejor qué necesitas.')

//- Invitación a la entrevista: texto, qué ofrecemos y dos botones. El link
//- lleva al formulario de Google, behavior.js le agrega la respuesta marcada.
mixin invitacionEntrevista(lugar, texto)
  - const formEntrevista = 'https://docs.google.com/forms/d/e/1FAIpQLScdxU6Y8GRpRIr5dO7NRKtDNW4O2BaZB8tKNhkBO5q7g8UNPw/viewform?usp=pp_url'
  .entrevista(data-lugar=lugar)
    p.entrevista-texto= texto
    p.nota Son 20 minutos, por WhatsApp, llamada o videollamada. Si participas, te invitamos a nuestros encuentros y al grupo de personas usuarias que nos ayudan a mejorar el sitio.
    .entrevista-botones
      a.entrevista-si(href=formEntrevista target="_blank" rel="noopener") Sí, quiero platicar
      button.entrevista-no(type="button") No, gracias
