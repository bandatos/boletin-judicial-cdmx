include head.pug
include chrome.pug
include mixins.pug

//- noindex siempre: la ficha lista los juicios de una persona.
+head(`${persona.nombre} — ${siteTitle}`, null, true)
  +siteHeader('personas')
  +breadcrumbs([[siteTitle, '/'], ['Personas', '/personas'], [persona.nombre]])

  .container.empresa-view
    h1= persona.nombre

    .stats-grid
      .stat
        strong= resultado.totalExpedientes == null ? `${num(resultado.pagina * 50)}+` : num(resultado.totalExpedientes)
        span expedientes
      .stat
        strong= num(persona.avisos)
        span avisos
      .stat
        strong= num(persona.como_actora)
        span como actora
      .stat
        strong= num(persona.como_demandada)
        span como demandada
    if persona.primer_boletin
      p.nota Del #{fechaLarga(persona.primer_boletin)} al #{fechaLarga(persona.ultimo_boletin)}. Puede incluir juicios de otras personas con el mismo nombre.

    .bloque
      h3 Expedientes
      p.nota Del más reciente al más viejo.
      if !resultado.grupos.length
        p Sin avisos encontrados.
      #result-list
        each g in resultado.grupos
          +resultCard(g)

    +paginacion(resultado.pagina, resultado.totalExpedientes == null ? null : Math.ceil(resultado.totalExpedientes / 50), n => `/personas/${persona.slug}?p=${n}`, resultado.hayMas)

  +siteFooter()
