include head.pug
include chrome.pug
include mixins.pug

//- Portada: buscador general y tablas por tema, con el orden de la portada
//- de país de sociedad.info (tarjeta con título, pestañas, tabla y "ver
//- todos"). Se indexa: no lleva nombres de personas.

+head(`${siteTitle}: juicios en la Ciudad de México`, 'Busca en el Boletín Judicial del Poder Judicial de la Ciudad de México desde 2016: juicios civiles, mercantiles y familiares de empresas y personas, por nombre, expediente, juzgado o fecha.')
  +siteHeader('')
  main#contenido

    .container.portada-view
      section.infobanner
        h1 ¿No sabes el número de expediente?
        p.
          Encuéntralo con el nombre de cualquiera de las partes. Buscamos en todos
          los avisos que el Poder Judicial de la Ciudad de México publica cada día
          hábil desde octubre de 2016, con la liga a cada publicación oficial.
        form(method="GET" action="/buscar")
          input(type="search" name="q" placeholder="Nombre de persona, empresa o institución" autocomplete="off" aria-label="Nombre de una de las partes")
          button(type="submit") Buscar
        p.busqueda-secundaria ¿Ya tienes el número? También puedes escribirlo, por ejemplo «184/2025».
        if resumen
          p.cifras-portada
            a(href="/empresas")= `${num(resumen.empresas)} empresas`
            if personas
              span(aria-hidden="true") ·
              a(href="/personas")= `${num(personas)} personas`
            if resumen.desde
              - const [a1, a2] = [resumen.desde.slice(0, 4), (resumen.hasta || resumen.desde).slice(0, 4)]
              span(aria-hidden="true") ·
              a(href="/fecha")= a1 === a2 ? `boletines de ${a1}` : `boletines de ${a1} a ${a2}`

      section.para-que(aria-labelledby="titulo-para-que")
        h2#titulo-para-que Para qué sirve
        ul
          li
            strong Te demandaron y todavía no te notificaron.
            span Busca tu nombre: los acuerdos de cada juicio se publican en el boletín.
          li
            strong Un familiar tiene un juicio y no tienes los papeles.
            span Con su nombre encuentras el juzgado y el número de expediente.
          li
            strong Hay una obra o un conflicto en tu colonia.
            span Busca a la desarrolladora o a la empresa y mira qué juicios tiene.
        p.nota
          | Con el número puedes guardar el expediente en #[a(href="/mis-expedientes") Mis expedientes] para ver cuándo se mueve. ¿Necesitas orientación? #[a(href=TDV_URL target="_blank" rel="noopener") Pregúntale a Todo Derecho Vecino].

      nav.acciones-portada(aria-label="Secciones")
        a(href="/empresas") Empresas
        a(href="/personas") Personas
        if hayEstadisticas
          a(href="/tipos") Tipos de juicio
          a(href="/salas") Desempeño de salas y juzgados
        a(href="/fecha") Lo publicado cada día
        a(href="/sources") De dónde vienen los datos

      +tarjeta('📊', 'Avisos por año')
        +pestanas('grafico', [{ id: 'grafico-publicacion', titulo: 'Por fecha de publicación' }, { id: 'grafico-expediente', titulo: 'Por año del expediente' }])
        #grafico-publicacion(role="tabpanel" aria-labelledby="tab-grafico-publicacion")
          +graficoAnioMes(chartPublicacion, chartPublicacionMes, 'publicacion-periodo')
          p.nota Lo que publicó el boletín en cada período. 2016 empieza en octubre, el primer boletín disponible.
        #grafico-expediente(role="tabpanel" aria-labelledby="tab-grafico-expediente" hidden)
          +graficoAnios(chart)
          p.nota Avisos según el año del número de expediente ("184/2019" es 2019): de qué época son los juicios con acuerdos publicados. Los años recientes tienen menos porque esos juicios son nuevos.

      if datos.empresas
        +tarjeta('🏢', 'Empresas con más juicios', '/empresas', 'Ver todas las empresas')
          +pestanas('empresas', [{ id: 'empresas-avisos', titulo: 'Con más avisos' }, { id: 'empresas-expedientes', titulo: 'Con más expedientes' }])
          each grupo in [['empresas-avisos', datos.empresas.porAvisos], ['empresas-expedientes', datos.empresas.porExpedientes]]
            div(id=grupo[0] role="tabpanel" aria-labelledby=`tab-${grupo[0]}` hidden=(grupo[0] !== 'empresas-avisos'))
              table.empresas-tabla
                thead
                  tr
                    th Empresa
                    th.num Avisos
                    th.num Expedientes
                    th Período
                tbody
                  each e in grupo[1]
                    tr
                      td
                        a(href=`/empresas/${e.slug}`)= e.nombre
                      td.num= num(e.avisos)
                      td.num= num(e.expedientes || 0)
                      td.periodo= `${fechaCorta(e.primer_boletin)} a ${fechaCorta(e.ultimo_boletin)}`

      +tarjeta('📅', 'Boletines publicados', '/fecha', 'Ver el calendario')
        +pestanas('boletines', [{ id: 'boletines-recientes', titulo: 'Más recientes' }, { id: 'boletines-mas', titulo: 'Con más avisos' }])
        each grupo in [['boletines-recientes', datos.ultimosDias], ['boletines-mas', datos.diasConMasAvisos]]
          div(id=grupo[0] role="tabpanel" aria-labelledby=`tab-${grupo[0]}` hidden=(grupo[0] !== 'boletines-recientes'))
            table.empresas-tabla
              thead
                tr
                  th Fecha
                  th.num Avisos
              tbody
                each d in grupo[1]
                  tr
                    td
                      a(href=`/fecha/${d.iso}`)= fechaLarga(d.iso)
                    td.num= num(d.avisos)

      +tarjeta('⚖️', 'Juzgados y tipos de juicio', '/buscar', 'Buscar avisos')
        +pestanas('juzgados', [{ id: 'juzgados-avisos', titulo: 'Juzgados con más avisos' }, { id: 'tipos-avisos', titulo: 'Tipos de juicio más frecuentes' }])
        div#juzgados-avisos(role="tabpanel" aria-labelledby="tab-juzgados-avisos")
          table.empresas-tabla
            thead
              tr
                th Juzgado
                th.num Avisos
            tbody
              each j in datos.juzgados
                tr
                  td
                    a(href=`/juzgado/${j.slug}`)= j.nombre
                  td.num= num(j.avisos)
        div#tipos-avisos(role="tabpanel" aria-labelledby="tab-tipos-avisos" hidden)
          table.empresas-tabla
            thead
              tr
                th Tipo de juicio
                th.num Avisos
            tbody
              each t in datos.tipos
                tr
                  td
                    a(href=`/buscar?${new URLSearchParams({ tipo: t.tipo })}`)= t.tipo
                  td.num= num(t.avisos)

      +tarjeta('🗄️', 'Fuentes de datos', '/sources', 'De dónde vienen los datos')
        p.
          Boletín Judicial del Poder Judicial de la Ciudad de México. Cada aviso
          lleva a la página exacta del PDF oficial donde se publicó, para
          verificarlo contra el original.

  +siteFooter()
