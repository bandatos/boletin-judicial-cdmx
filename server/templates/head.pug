//- noindex: fichas, juzgados y resultados de búsqueda listan nombres de
//- personas en juicios (muchos familiares). El boletín es público, pero que
//- un buscador los indexe hace que buscar a alguien devuelva sus juicios.
mixin head(title, description, noindex)
  doctype html
  html(lang="es")
    head
      meta(charset="UTF-8")
      meta(name="viewport" content="width=device-width, initial-scale=1.0")
      title= title
      if description
        meta(name="description" content=description)
      if noindex
        meta(name="robots" content="noindex")
      link(rel="icon" type="image/webp" href=asset('img/favicon-32.webp'))
      link(rel="apple-touch-icon" href=asset('img/favicon-180.webp'))
      //- Antes de pintar: marca si hay JS, si ya se respondió la pregunta de
      //- intención, si ya se contestó la invitación a la entrevista y si toca
      //- volver a ofrecerla (3 días después de responder). Así las franjas se
      //- muestran o no por CSS sin mover la página.
      script.
        (function (d) { var c = ' js'; try { var r = localStorage.getItem('boletin-intencion'), e = localStorage.getItem('boletin-entrevista'), f = Number(localStorage.getItem('boletin-intencion-fecha')) || 0, o = localStorage.getItem('boletin-reofrecida'); if (r) c += ' intencion-vista'; if (e) c += ' entrevista-respondida'; else if (r && r !== 'cerrada' && !o && Date.now() - f > 3 * 864e5) c += ' entrevista-reofrecer'; } catch (x) { c += ' intencion-vista entrevista-respondida'; } d.className += c; })(document.documentElement);
      //- Todo el CSS inline (ver cssInline en lib/views.js).
      style!= css
      if gaId
        script(async src=`https://www.googletagmanager.com/gtag/js?id=${gaId}`)
        script.
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', '#{gaId}');
    body
      block
